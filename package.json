{
  "name": "nabatable-platform",
  "version": "0.1.0",
  "private": true,
  "lint-staged": {
    "reserve/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "server/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "lib/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "scripts/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx,.js server lib scripts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "validate:env": "tsx scripts/validate-env.ts",
    "env:sync-example": "tsx scripts/generate-env-local-example.ts",
    "prebuild": "npm run validate:env",
    "predev": "npm run validate:env && tsx scripts/ensure-dev-port.ts",
    "reserve:dev": "vite --config reserve/vite.config.ts",
    "reserve:build": "vite build --config reserve/vite.config.ts",
    "storybook": "storybook dev -p 6006 -c reserve/.storybook",
    "storybook:build": "storybook build -c reserve/.storybook -o reserve/storybook-static",
    "analyze": "vite build --config reserve/vite.config.ts --mode analyze",
    "prepare": "husky",
    "secret:scan": "gitleaks detect --no-banner --redact && trufflehog filesystem --no-update --only-verified --fail .",
    "guard:no-shadcn": "node scripts/check-no-shadcn.mjs",
    "load:booking-matrix": "tsx scripts/booking-matrix-load.ts",
    "load:booking-pack": "tsx scripts/booking-pack-fill.ts",
    "observability:baseline": "tsx scripts/observability/export-capacity-baselines.ts",
    "observability:export": "tsx scripts/observability/export-capacity-metrics.ts",
    "flags:audit": "tsx scripts/feature-flags/audit.ts",
    "email:check": "tsx scripts/email/check-resend-status.ts",
    "email:preview": "tsx -r tsconfig-paths/register scripts/preview-booking-email.ts",
    "email:setup:notifications-domain": "tsx scripts/email/setup-notifications-domain.ts",
    "cloudflare:email-gateway:deploy": "bash scripts/cloudflare/deploy-email-gateway.sh",
    "cloudflare:email-gateway:versions": "script -q /dev/null npx wrangler deployments list --config \"cloudflare/email-queue-gateway/wrangler.jsonc\"",
    "cloudflare:email-gateway:rollback": "bash scripts/cloudflare/rollback-email-gateway.sh",
    "cloudflare:email-gateway:smoke": "dotenv -e .env.local -- tsx -r tsconfig-paths/register scripts/cloudflare/smoke-email-gateway.ts",
    "vercel:rollback": "npx vercel rollback",
    "jobs:hold-sweeper": "tsx -r tsconfig-paths/register scripts/jobs/run-hold-sweeper.ts",
    "jobs:allocations-pruner": "tsx -r tsconfig-paths/register scripts/jobs/run-allocations-pruner.ts",
    "assign:loop": "tsx -r tsconfig-paths/register scripts/ops-auto-assign-ultra-fast-loop.ts --slug white-horse-pub-waterbeach --date 2025-11-10",
    "booking:flow": "tsx -r tsconfig-paths/register scripts/run-booking-flow.ts",
    "db:reset": "tsx scripts/db/safe-run.ts reset",
    "db:migrate": "tsx scripts/db/safe-run.ts migrate",
    "db:seed-only": "tsx scripts/db/safe-run.ts seed-only",
    "db:full-reset": "tsx scripts/db/safe-run.ts full-reset",
    "db:wipe": "tsx scripts/db/safe-run.ts wipe",
    "db:check-drift": "tsx scripts/db/check-drift.ts",
    "apply:factory-config": "bash scripts/apply_factory_config.sh",
    "supabase:apply-order:staging:dry": "SUPABASE_DB_URL=YOUR_STAGING_DB_URL bash scripts/apply_supabase_order.sh --env staging --dry-run",
    "supabase:apply-order:staging": "bash scripts/apply_supabase_order.sh --env staging --confirm",
    "supabase:apply-order:ordered": "SUPABASE_DB_URL=YOUR_STAGING_DB_URL bash scripts/ordered_apply.sh",
    "vibeproxy:health": "bash scripts/vibeproxy_health_check.sh",
    "db:push": "echo '📤 Pushing migrations to Supabase remote...' && supabase db push",
    "db:pull": "echo '📥 Pulling schema from Supabase remote...' && supabase db pull",
    "db:status": "supabase migration list"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/render": "^2.0.0",
    "@supabase/mcp-server-supabase": "^0.5.9",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/query-persist-client-core": "^5.91.10",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crisp-sdk-web": "^1.0.26",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "import-in-the-middle": "^2.0.5",
    "libphonenumber-js": "1.12.35",
    "lodash": "^4.17.21",
    "lucide-react": "^0.555.0",
    "luxon": "^3.7.2",
    "motion": "^12.30.0",
    "next": "^16.1.6",
    "next-plausible": "^3.12.5",
    "next-sitemap": "^4.2.3",
    "nextjs-toploader": "^3.9.17",
    "posthog-js": "^1.336.4",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.67.0",
    "react-intersection-observer": "^10.0.0",
    "react-router-dom": "^7.10.0",
    "react-tooltip": "^5.30.0",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.5.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.5",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.58.1",
    "@storybook/react": "10.1.4",
    "@storybook/react-vite": "^10.1.4",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "axe-core": "4.11.1",
    "baseline-browser-mapping": "^2.9.19",
    "chrome-devtools-mcp": "^0.11.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "28.0.0",
    "lint-staged": "^16.2.7",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "shadcn": "^3.5.1",
    "storybook": "^10.1.4",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "4.0.18",
    "vitest-axe": "0.1.0"
  },
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=10.12.1"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "tar": "^7.5.2",
      "prismjs": "^1.30.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
