{
  "name": "nabatable-platform",
  "version": "0.1.0",
  "private": true,
  "lint-staged": {
    "reserve/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "server/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "lib/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "scripts/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "cloudflare/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/vitest/junit.xml --slowTestThreshold=1000",
    "test:stability": "vitest run --sequence.shuffle --reporter=verbose",
    "react:doctor": "react-doctor",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "profile": "mkdir -p .profiles/web && NODE_OPTIONS='--cpu-prof --cpu-prof-dir=.profiles/web' next dev --webpack",
    "build": "next build --webpack && pnpm run posthog:sourcemaps",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint --ext .ts,.tsx,.js server lib scripts src/app/app src/components/features && pnpm run guard:no-shadcn:ci && pnpm run guard:no-shadow-roots && pnpm run guard:typography-scale",
    "lint:workspaces": "pnpm --filter '@nabatable/*' -r lint",
    "lint:ops-ui": "eslint --max-warnings=0 \"src/app/app/**/*.{js,jsx,ts,tsx}\" \"src/components/features/**/*.{js,jsx,ts,tsx}\" && pnpm run guard:no-shadcn:strict",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "typecheck:workspaces": "pnpm --filter '@nabatable/*' -r typecheck",
    "test:coverage:workspaces": "pnpm --filter '@nabatable/*' -r test:coverage",
    "test:ci:workspaces": "pnpm --filter '@nabatable/*' -r test:ci",
    "build:workspaces": "pnpm --filter '@nabatable/*' -r build",
    "verify:workspaces": "pnpm --filter '@nabatable/*' -r verify",
    "format:check": "prettier --check AGENTS.md CHANGELOG.md package.json pnpm-workspace.yaml tsconfig.json tsconfig.strict.json tsconfig.worker.json typedoc.json .size-limit.json '.devcontainer/**/*.{json,Dockerfile}' '.factory/**/*.{json,yaml,md}' '.github/**/*.{yml,yaml,md}' 'cloudflare/**/*.{ts,json,yaml,md}' 'config/env.schema.ts' 'config/eslint/**/*.mjs' 'config/feature-flags.json' 'config/quality/**/*.{json,yaml}' 'docs/testing/**/*.md' 'docs/security/dast.md' 'docs/profiling.md' 'lib/observability/**/*.ts' 'src/proxy*.ts' 'src/app/api/client-error/**/*.ts' 'src/app/api/webhook/error-insight/**/*.ts' 'scripts/governance/**/*.ts' 'scripts/quality/**/*.ts' 'tests/api/error-insight*.test.ts' 'tests/cloudflare/*.test.ts' 'tests/lib/observability/*.test.ts' 'tests/scripts/*.test.ts' 'tests/server/client-error-route.test.ts' 'scripts/ci/**/*.{ts,md}' 'scripts/deploy/**/*.ts' 'scripts/release/**/*.ts' 'scripts/monitoring/**/*.ts' 'scripts/observability/slo-evidence.ts' 'scripts/db/{backup,migrations,restore}/**/*.ts' 'scripts/cloudflare/recovery/**/*.{ts,md}' 'infra/**/*.{json,yaml,yml,md}' 'config/ci/**/*.json' 'config/db/**/*.{json,md}' 'config/recovery/**/*.yaml' 'config/observability/monitoring.yaml' 'docs/ci/**/*.md' 'docs/runbooks/**/*.md' 'docs/DATABASE_MIGRATIONS.md' 'playwright.staging.config.ts' 'tests/e2e/staging/**/*.ts' 'tests/scripts/ci/**/*.ts' 'tests/scripts/recovery-fixtures.ts'",
    "format:write": "prettier --write .",
    "agents:validate": "tsx scripts/governance/validate-agents.ts",
    "openapi:validate": "tsx scripts/governance/validate-openapi.ts",
    "docs:generate": "typedoc",
    "design:tokens-json": "node scripts/design-system/generate-tokens-json.mjs",
    "design:tokens-json:check": "node scripts/design-system/generate-tokens-json.mjs --check",
    "quality:dead-code": "tsx scripts/quality/check-knip-ratchet.ts",
    "quality:duplicates": "jscpd app components hooks lib reserve server src cloudflare --config .jscpd.json",
    "quality:bundles": "pnpm build:workspaces && size-limit",
    "quality": "pnpm quality:dead-code && pnpm quality:duplicates && pnpm quality:bundles",
    "check:large-files": "bash scripts/pre-commit/check-file-size.sh --all",
    "check:feature-flags": "tsx scripts/governance/check-feature-flags.ts",
    "verify": "pnpm agents:validate && pnpm openapi:validate && pnpm check:feature-flags && pnpm check:large-files && pnpm format:check && pnpm lint && pnpm lint:workspaces && pnpm typecheck && pnpm typecheck:strict && pnpm typecheck:workspaces && pnpm test:coverage && pnpm test:coverage:workspaces && pnpm quality:dead-code && pnpm quality:duplicates",
    "validate:env": "tsx scripts/validate-env.ts",
    "posthog:schema:status": "posthog-cli exp schema status",
    "posthog:schema:pull": "expect scripts/posthog-schema-pull.expect && node scripts/posthog-schema-postprocess.mjs",
    "posthog:sourcemaps": "tsx scripts/posthog-sourcemaps.ts",
    "prebuild": "pnpm run validate:env",
    "predev": "pnpm run validate:env && tsx scripts/ensure-dev-port.ts",
    "reserve:dev": "vite --config reserve/vite.config.ts",
    "reserve:build": "vite build --config reserve/vite.config.ts",
    "storybook": "storybook dev -p 6006 -c reserve/.storybook",
    "storybook:build": "storybook build -c reserve/.storybook -o test-results/storybook-static",
    "analyze": "vite build --config reserve/vite.config.ts --mode analyze",
    "prepare": "husky",
    "secret:scan": "tsx scripts/security/secret-scan.ts",
    "security:backlog": "node scripts/security/build-deepsec-backlog.mjs && prettier --write docs/security/deepsec-remediation-board.md",
    "security:regression": "vitest run tests/server/team-invitations-security.test.ts tests/server/auth/callback-route-security.test.ts tests/server/tenant-authorization-sprint2.test.ts tests/server/csrf-protected-mutations.test.ts tests/lib/security/safe-url.test.ts tests/lib/security/script-json.test.ts tests/server/restaurant-security-schema.test.ts tests/server/cron-routes-auth.test.ts tests/server/security/session-recovery-access-token.test.ts tests/lib/csv-export.test.ts tests/lib/query-params.test.ts tests/server/auth/signin-throttle.test.ts tests/server/auth/signin-route-magic-link-policy.test.ts tests/server/dual-sync-publish-orchestrator.test.ts tests/server/email-processing-security.test.ts tests/server/security-events.test.ts tests/server/capacity/soft-holds-rpc-security.test.ts tests/server/google-business-profile-callback-route.test.ts tests/server/google-business-profile-readonly-v1.test.ts tests/server/restaurant-google-business-profile-routes.test.ts tests/server/restaurant-google-business-v1-routes.test.ts tests/server/proxy-google-business-callback.test.ts tests/server/customers.test.ts tests/server/public-bookings-route.test.ts tests/server/public-booking-delete-route.test.ts tests/server/restaurants/create.test.ts tests/server/capacity/assignment-rpc-privileges-security.test.ts",
    "security:guard:service-role": "node scripts/security/check-service-role-routes.mjs",
    "guard:no-shadcn": "node scripts/check-no-shadcn.mjs",
    "guard:no-shadcn:strict": "node scripts/check-no-shadcn.mjs --strict",
    "guard:no-shadcn:ci": "node scripts/check-no-shadcn.mjs --primitives-only --baseline=config/shadcn-primitives-baseline.json",
    "guard:no-shadcn:update-baseline": "node scripts/check-no-shadcn.mjs --primitives-only --baseline=config/shadcn-primitives-baseline.json --update-baseline",
    "guard:no-shadow-roots": "node scripts/check-no-shadow-roots.mjs",
    "guard:typography-scale": "node scripts/check-typography-scale.mjs",
    "guard:typography-scale:update-baseline": "node scripts/check-typography-scale.mjs --update-baseline",
    "guard:luma": "node scripts/check-luma-compliance.mjs --baseline=config/qa/luma-baseline.json",
    "guard:luma:strict": "node scripts/check-luma-compliance.mjs --fail-on=exception --baseline=config/qa/luma-baseline.json",
    "guard:luma:update-baseline": "node scripts/check-luma-compliance.mjs --baseline=config/qa/luma-baseline.json --update-baseline",
    "load:booking-pack": "tsx scripts/booking-pack-fill.ts",
    "observability:baseline": "tsx scripts/observability/export-capacity-baselines.ts",
    "observability:export": "tsx scripts/observability/export-capacity-metrics.ts",
    "sms:delivery:pull:staging-vercel-branch": "npx vercel env pull .env.vercel.preview --environment=preview --git-branch codex/Menu --yes",
    "sms:delivery:readiness": "tsx -r tsconfig-paths/register scripts/sms-delivery-readiness.ts --target all",
    "sms:delivery:readiness:staging-vercel": "tsx -r tsconfig-paths/register scripts/sms-delivery-readiness.ts --target staging --check-vercel-env",
    "sms:delivery:readiness:staging-vercel:strict": "tsx -r tsconfig-paths/register scripts/sms-delivery-readiness.ts --target staging --check-vercel-env --strict",
    "sms:delivery:readiness:staging-vercel:branch-strict": "tsx -r tsconfig-paths/register scripts/sms-delivery-readiness.ts --target staging --check-vercel-env --vercel-git-branch codex/Menu --strict",
    "sms:delivery:readiness:staging-vercel:branch-strict:env-run": "tsx -r tsconfig-paths/register scripts/vercel-preview-env-run.ts --branch codex/Menu -- pnpm exec tsx -r tsconfig-paths/register scripts/sms-delivery-readiness.ts --target staging --check-vercel-env --vercel-git-branch codex/Menu --callback-base-url https://nabatable-git-codex-menu-lapen-inns-projects.vercel.app --expected-staging-project-ref ndxmivcrehsacuerwxtm --strict --skip-pulled-env-files --skip-local-env-files",
    "sms:delivery:env:preview:metadata": "tsx -r tsconfig-paths/register scripts/sms-delivery-vercel-preview-audit.ts --branch codex/Menu --metadata-only",
    "sms:delivery:audit:staging-vercel-preview": "tsx -r tsconfig-paths/register scripts/sms-delivery-vercel-preview-audit.ts --branch codex/Menu --expected-staging-project-ref ndxmivcrehsacuerwxtm",
    "sms:delivery:deployment:preview": "tsx -r tsconfig-paths/register scripts/sms-delivery-preview-deployment-check.ts --branch codex/Menu --alias https://nabatable-git-codex-menu-lapen-inns-projects.vercel.app",
