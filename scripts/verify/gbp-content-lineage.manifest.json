{
  "version": 1,
  "entries": [
    {
      "storeKey": "external-profiles",
      "location": "db:restaurant_external_profiles",
      "owner": "gbp-runtime",
      "tenantKey": "restaurant_id",
      "contentFields": [
        "external_account_id",
        "external_location_id",
        "external_resource_name",
        "external_place_id",
        "last_error"
      ],
      "provenance": "exact linked profile identity",
      "parents": [],
      "expirySource": "external_gate",
      "readFilter": "exact current profile/generation/epoch and linked",
      "purgeAction": "scrub",
      "notes": "hide before disconnect purge; preserve row identity"
    },
    {
      "storeKey": "external-profile-snapshots",
      "location": "db:restaurant_external_profile_snapshots",
      "owner": "gbp-runtime",
      "tenantKey": "external_profile_id->restaurant_id",
      "contentFields": ["source_revision", "payload"],
      "provenance": "fresh_provider_fetch",
      "parents": ["external-profiles"],
      "expirySource": "inherit_fresh_fetch",
      "readFilter": "expires_at > now and exact current profile fence",
      "purgeAction": "delete",
      "notes": "unmodified temporary response only"
    },
    {
      "storeKey": "external-profile-drafts",
      "location": "db:restaurant_external_profile_drafts",
      "owner": "legacy-gbp",
      "tenantKey": "restaurant_id",
      "contentFields": ["source_snapshot_refs"],
      "provenance": "external profile snapshot copies",
      "parents": ["external-profile-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "unexpired source snapshots only",
      "purgeAction": "delete",
      "notes": "legacy approval draft"
    },
    {
      "storeKey": "external-profile-sync-runs",
      "location": "db:restaurant_external_profile_sync_runs",
      "owner": "legacy-gbp",
      "tenantKey": "restaurant_id",
      "contentFields": ["error_message"],
      "provenance": "provider sync run",
      "parents": ["external-profile-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "safe metadata only after expiry",
      "purgeAction": "scrub",
      "notes": "retain safe status and codes"
    },
    {
      "storeKey": "dual-sync-snapshots",
      "location": "db:dual_sync_snapshot_runs",
      "owner": "dual-sync",
      "tenantKey": "restaurant_id",
      "contentFields": ["raw_payload", "canonical_snapshot", "error_message"],
      "provenance": "fresh fetch then in-memory canonicalization",
      "parents": ["external-profile-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "expires_at > now and exact current profile fence",
      "purgeAction": "delete",
      "notes": "canonicalization never resets expiry"
    },
    {
      "storeKey": "field-states",
      "location": "db:dual_sync_field_states",
      "owner": "dual-sync",
      "tenantKey": "restaurant_id",
      "contentFields": ["gbp_value_hash", "metadata"],
      "provenance": "field-level gbp_field_provenance_v1",
      "parents": ["dual-sync-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "unexpired provenance only",
      "purgeAction": "scrub",
      "notes": "preserve Core hashes and owner state"
    },
    {
      "storeKey": "outbound-candidates",
      "location": "db:dual_sync_outbound_candidates",
      "owner": "dual-sync",
      "tenantKey": "restaurant_id",
      "contentFields": ["proposed_value", "baseline_gbp_hash"],
      "provenance": "Core or Google field provenance",
      "parents": ["field-states"],
      "expirySource": "inherit_parent",
      "readFilter": "unexpired provenance for Google-derived values",
      "purgeAction": "scrub",
      "notes": "owner-authored proposed values remain"
    },
    {
      "storeKey": "dual-sync-jobs",
      "location": "db:dual_sync_jobs",
      "owner": "dual-sync",
      "tenantKey": "restaurant_id",
      "contentFields": ["payload", "last_error_message", "dead_letter_reason"],
      "provenance": "enqueue source manifest",
      "parents": ["dual-sync-snapshots", "outbound-candidates"],
      "expirySource": "inherit_parent",
      "readFilter": "unexpired and exact current fence",
      "purgeAction": "scrub",
      "notes": "queue copies never extend expiry"
    },
    {
      "storeKey": "publish-operations",
      "location": "db:dual_sync_publish_operations",
      "owner": "dual-sync-publish",
      "tenantKey": "restaurant_id",
      "contentFields": ["external_response", "error_message"],
      "provenance": "publish operation source",
      "parents": ["dual-sync-jobs"],
      "expirySource": "inherit_parent",
      "readFilter": "content columns require unexpired provenance",
      "purgeAction": "scrub",
      "notes": "retain allowlisted IDs, hashes, masks, status and error code"
    },
    {
      "storeKey": "publish-groups",
      "location": "db:dual_sync_publish_operation_groups",
      "owner": "dual-sync-publish",
      "tenantKey": "restaurant_id",
      "contentFields": ["preflight_result", "request_summary", "response_summary", "error_message"],
      "provenance": "grouped publish operations",
      "parents": ["publish-operations"],
      "expirySource": "inherit_earliest_parent",
      "readFilter": "content columns require unexpired provenance",
      "purgeAction": "scrub",
      "notes": "grouping never resets expiry"
    },
    {
      "storeKey": "publish-batches",
      "location": "db:dual_sync_publish_batches",
      "owner": "dual-sync-publish",
      "tenantKey": "restaurant_id",
      "contentFields": ["plan_summary", "error_message"],
      "provenance": "publish groups",
      "parents": ["publish-groups"],
      "expirySource": "inherit_earliest_parent",
      "readFilter": "content columns require unexpired provenance",
      "purgeAction": "scrub",
      "notes": "retain counts, IDs, hashes, status and timestamps"
    },
    {
      "storeKey": "request-logs",
      "location": "db:dual_sync_google_request_logs",
      "owner": "dual-sync-publish",
      "tenantKey": "restaurant_id",
      "contentFields": ["request_summary", "response_summary", "error_message"],
      "provenance": "provider request lifecycle",
      "parents": ["publish-operations"],
      "expirySource": "inherit_parent",
      "readFilter": "retention_expires_at > now",
      "purgeAction": "delete",
      "notes": "no bodies, tokens, PII or provider values in structured logs"
    },
    {
      "storeKey": "request-log-archives",
      "location": "db:dual_sync_google_request_log_archives",
      "owner": "data-governance",
      "tenantKey": "restaurant_id",
      "contentFields": ["archived_payload"],
      "provenance": "legacy request-log copy",
      "parents": ["request-logs"],
      "expirySource": "legacy_original_expiry",
      "readFilter": "never expose archived_payload",
      "purgeAction": "scrub",
      "notes": "archive production stopped; purge legacy payload without recopy"
    },
    {
      "storeKey": "foodmenus-settings",
      "location": "db:restaurant_gbp_food_menu_settings",
      "owner": "menus",
      "tenantKey": "restaurant_id",
      "contentFields": ["menu_label"],
      "provenance": "owner or Google field provenance",
      "parents": ["foodmenus-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "Google label requires unexpired provenance",
      "purgeAction": "scrub",
      "notes": "preserve owner label"
    },
    {
      "storeKey": "foodmenus-snapshots",
      "location": "db:restaurant_gbp_food_menu_snapshots",
      "owner": "menus",
      "tenantKey": "restaurant_id",
      "contentFields": [
        "food_menus_name",
        "raw_food_menus",
        "canonical_food_menus",
        "error_message"
      ],
      "provenance": "fresh_provider_fetch",
      "parents": ["external-profiles"],
      "expirySource": "inherit_fresh_fetch",
      "readFilter": "expires_at > now and exact current fence",
      "purgeAction": "delete",
      "notes": "normalized projection should be in memory"
    },
    {
      "storeKey": "foodmenus-projected-identities",
      "location": "db:restaurant_gbp_food_menu_projected_identities",
      "owner": "menus",
      "tenantKey": "restaurant_id",
      "contentFields": ["google_path"],
      "provenance": "FoodMenus snapshot projection",
      "parents": ["foodmenus-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "unexpired parent only",
      "purgeAction": "delete",
      "notes": "stop creating persistent projected identities"
    },
    {
      "storeKey": "foodmenus-reviews",
      "location": "db:restaurant_gbp_food_menu_import_reviews",
      "owner": "menus",
      "tenantKey": "restaurant_id",
      "contentFields": [
        "google_path",
        "google_value",
        "local_value",
        "menu_label",
        "error_message"
      ],
      "provenance": "FoodMenus snapshot comparison",
      "parents": ["foodmenus-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "unexpired parent only",
      "purgeAction": "delete",
      "notes": "review content is temporary"
    },
    {
      "storeKey": "foodmenus-publish",
      "location": "db:restaurant_gbp_food_menu_publish_attempts",
      "owner": "menus",
      "tenantKey": "restaurant_id",
      "contentFields": [
        "projected_payload",
        "projected_payload_hash",
        "request_payload",
        "response_payload",
        "google_response",
        "error_message"
      ],
      "provenance": "owner projection plus provider response",
      "parents": ["foodmenus-reviews"],
      "expirySource": "inherit_earliest_parent",
      "readFilter": "unexpired provenance",
      "purgeAction": "scrub",
      "notes": "retain safe status and digest audit only"
    },
    {
      "storeKey": "field-policy-versions",
      "location": "db:dual_sync_field_policy_versions",
      "owner": "dual-sync",
      "tenantKey": "restaurant_id nullable",
      "contentFields": ["policy_snapshot"],
      "provenance": "operator policy definition",
      "parents": [],
      "expirySource": "metadata_policy",
      "readFilter": "policy metadata only",
      "purgeAction": "metadata_only",
      "notes": "policy snapshot contains no provider values"
    },
    {
      "storeKey": "provider-definitions",
      "location": "db:provider-definition-dictionaries",
      "owner": "gbp-runtime",
      "tenantKey": "none",
      "contentFields": ["categories", "attributes", "service_items"],
      "provenance": "global provider aggregation",
      "parents": ["external-profile-snapshots"],
      "expirySource": "none",
      "readFilter": "disabled",
      "purgeAction": "stop_persisting",
      "notes": "compute normalized definitions in memory; no global aggregate"
    },
    {
      "storeKey": "canonical-profile-tables",
      "location": "db:restaurant_categories|restaurant_service_areas|restaurant_attributes|restaurant_service_items|restaurant_business_details",
      "owner": "core-profile",
      "tenantKey": "restaurant_id",
      "contentFields": [
        "display_name",
        "more_hours_types_json",
        "place_data_json",
        "value_metadata_json",
        "payload_json",
        "business_name"
      ],
      "provenance": "gbp_field_provenance_v1 per field",
      "parents": ["dual-sync-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "owner fields always; Google fields only while unexpired",
      "purgeAction": "scrub",
      "notes": "mixed rows preserve Core owner values"
    },
    {
      "storeKey": "canonical-menu-hierarchy",
      "location": "db:restaurant_menus|restaurant_menu_sections|restaurant_menu_items|restaurant_menu_item_options|restaurant_menu_item_extensions",
      "owner": "menus",
      "tenantKey": "restaurant_id",
      "contentFields": ["google_path", "google_metadata", "label", "external_item_id"],
      "provenance": "field-level source/provenance",
      "parents": ["foodmenus-reviews"],
      "expirySource": "inherit_parent",
      "readFilter": "Google fields require unexpired provenance",
      "purgeAction": "scrub",
      "notes": "preserve owner menu hierarchy"
    },
    {
      "storeKey": "field-provenance",
      "location": "db:gbp_field_provenance_v1",
      "owner": "data-governance",
      "tenantKey": "restaurant_id",
      "contentFields": [],
      "provenance": "hash-only lineage",
      "parents": ["external-profile-snapshots"],
      "expirySource": "fresh_fetch_only",
      "readFilter": "metadata only",
      "purgeAction": "metadata_only",
      "notes": "no provider values"
    },
    {
      "storeKey": "legacy-sync",
      "location": "db:gbp_sync_v2_drafts|gbp_sync_v2_decisions|gbp_sync_v2_publish_jobs|gbp_sync_v2_publish_events",
      "owner": "legacy-gbp",
      "tenantKey": "restaurant_id",
      "contentFields": [
        "payload",
        "nabatable_snapshot",
        "google_snapshot",
        "current_value",
        "proposed_value",
        "response_payload",
        "error_message"
      ],
      "provenance": "legacy provider/workflow copy",
      "parents": ["external-profile-snapshots"],
      "expirySource": "inherit_parent",
      "readFilter": "hidden unless unexpired",
      "purgeAction": "delete",
      "notes": "retire after migration"
    },
    {
      "storeKey": "replay-fixtures",
      "location": "repo:server/dual-sync/replay/fixtures.ts",
      "owner": "dual-sync-test",
      "tenantKey": "synthetic",
      "contentFields": ["fixture provider values"],
      "provenance": "synthetic only",
      "parents": [],
      "expirySource": "not_production",
      "readFilter": "test-only",
      "purgeAction": "metadata_only",
      "notes": "scanner rejects production imports"
    },
    {
      "storeKey": "react-query",
      "location": "browser:TanStack Query persistence",
      "owner": "frontend-platform",
      "tenantKey": "query key restaurant segment",
      "contentFields": ["GBP state, candidates, jobs, previews, metrics"],
      "provenance": "API responses",
      "parents": ["dual-sync-snapshots", "outbound-candidates", "dual-sync-jobs"],
      "expirySource": "none",
      "readFilter": "denylist all GBP/dual-sync keys",
      "purgeAction": "stop_persisting",
      "notes": "Wave3 clears existing memory on disconnect"
    },
    {
      "storeKey": "http-caches",
      "location": "http:GBP and dual-sync API routes",
      "owner": "web-platform",
      "tenantKey": "authenticated route restaurant id",
      "contentFields": ["all response bodies"],
      "provenance": "server response",
      "parents": ["dual-sync-snapshots"],
      "expirySource": "none",
      "readFilter": "private no-store max-age=0",
      "purgeAction": "stop_persisting",
      "notes": "CDN cache disabled and Vary on Cookie/Authorization"
    },
    {
      "storeKey": "posthog",
      "location": "telemetry:PostHog",
      "owner": "observability",
      "tenantKey": "safe restaurant ID only",
      "contentFields": ["autocapture, replay, exception attributes"],
      "provenance": "screen/route boundary",
      "parents": ["http-caches"],
      "expirySource": "none",
      "readFilter": "safe allowlist only",
      "purgeAction": "stop_persisting",
      "notes": "autocapture/session replay disabled"
    },
    {
      "storeKey": "otel-vercel",
      "location": "telemetry:OTel|Vercel",
      "owner": "observability",
      "tenantKey": "safe restaurant ID only",
      "contentFields": ["trace attributes, logs, request snapshots"],
      "provenance": "server boundary",
      "parents": ["http-caches"],
      "expirySource": "none",
      "readFilter": "IDs/status/error codes only",
      "purgeAction": "stop_persisting",
      "notes": "no bodies, provider values, PII or tokens"
    },
    {
      "storeKey": "backups-pitr",
      "location": "external:Supabase backup and PITR",
      "owner": "infrastructure",
      "tenantKey": "database recovery scope",
      "contentFields": ["recoverable database content"],
      "provenance": "database backup",
      "parents": ["external-profile-snapshots", "dual-sync-snapshots", "foodmenus-snapshots"],
      "expirySource": "operator_attested_recovery_window",
      "readFilter": "production blocked without current proof",
      "purgeAction": "external_gate",
      "notes": "TTL=min(28,30-backup window-1), strictly positive"
    },
    {
      "storeKey": "cdn",
      "location": "external:Vercel CDN",
      "owner": "web-platform",
      "tenantKey": "route scope",
      "contentFields": ["HTTP response bodies"],
      "provenance": "http-caches",
      "parents": ["http-caches"],
      "expirySource": "none",
      "readFilter": "no-store",
      "purgeAction": "external_gate",
      "notes": "deployment header probe required"
    }
  ]
}
