# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.js
/.pnpm-store/

# next.js
/.next/
/out/
.next/
**/.next/
.reserve-dist

# Next.js ignores route segments starting with "_" so this folder is a local-only scratch area.
# Keep it out of git to avoid accidental commits of dead routes.
src/app/(public)/__dev/

# production
/build

# misc
.DS_Store
*.pem
*.tar.gz
*.tgz
*.dump
*.backup.gz
.turbo
cli-proxy-api
cli-proxy-api.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# stress/load artifacts
stress-test-*.log
test_output*.log
test_single_output.log
test-results/
playwright-report/
coverage/
.jscpd-report/
.profiles/
docs/api/
cloudflare/*/coverage/
cloudflare/*/dist/
cloudflare/*/.wrangler/

# temporary directories
tmp/
tasks/
/analysis/
/.cursor/plans/
/.deepsec/findings/

# backups
/backups/

# generated route maps
/route-map-ascii.txt
/route-map-mermaid.md
/route-map.json

# local env files
.env
.env.*
.env*.local
**/.env*
!.env.example
!.env.local.example

# vercel
.vercel

