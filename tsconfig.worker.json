{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/lib/*": ["./lib/*"],
      "@/types/*": ["./types/*", "./src/types/*"],
      "@/*": ["./*"],
      "@reserve/*": ["./reserve/*"],
      "@shared/*": ["./reserve/shared/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["@cloudflare/workers-types", "node"]
  }
}
