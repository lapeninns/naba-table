{
  "name": "nabatable-sms-summary-gateway",
  "main": "src/index.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-04-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "DAILY_BOOKING_SUMMARY_QUEUE",
        "queue": "nabatable-sms-daily-summary",
      },
    ],
    "consumers": [
      {
        "queue": "nabatable-sms-daily-summary",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "nabatable-sms-daily-summary-dlq",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAILY_BOOKING_SUMMARY_STATE",
        "class_name": "DailyBookingSummaryState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DailyBookingSummaryState"],
    },
    {
      "tag": "v2",
    },
  ],
  "vars": {
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "ERROR_INSIGHT_WEBHOOK_URL": "https://app.nabatable.com/api/webhook/error-insight",
    "SMS_SUMMARY_GATEWAY_PUBLIC_URL": "https://nabatable-sms-summary-gateway.amanshresthaaaaa.workers.dev",
  },
  "observability": {
    "enabled": true,
  },
  // Staging is a separate Worker with its own queue + DLQ and Durable Object namespace.
  // DELIVERY_MODE=sink makes the queue consumer skip Twilio entirely (see src/job.ts), so
  // no manager SMS/WhatsApp message can leave staging even if Twilio secrets are present.
  // Twilio/Supabase secrets are set with `wrangler secret put --env staging` and must be
  // the staging Supabase project and a Twilio test credential set, never production.
  "env": {
    "staging": {
      "name": "nabatable-sms-summary-gateway-staging",
      "workers_dev": true,
      "version_metadata": {
        "binding": "CF_VERSION_METADATA",
      },
      "triggers": {
        "crons": ["*/15 * * * *"],
      },
      "queues": {
        "producers": [
          {
            "binding": "DAILY_BOOKING_SUMMARY_QUEUE",
            "queue": "nabatable-sms-daily-summary-staging",
          },
        ],
        "consumers": [
          {
            "queue": "nabatable-sms-daily-summary-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "nabatable-sms-daily-summary-staging-dlq",
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DAILY_BOOKING_SUMMARY_STATE",
            "class_name": "DailyBookingSummaryState",
          },
        ],
      },
      "vars": {
        "DELIVERY_MODE": "sink",
        "POSTHOG_HOST": "https://eu.i.posthog.com",
        "ERROR_INSIGHT_WEBHOOK_URL": "https://nabatable-staging-ops.vercel.app/api/webhook/error-insight",
        "SMS_SUMMARY_GATEWAY_PUBLIC_URL": "https://nabatable-sms-summary-gateway-staging.amanshresthaaaaa.workers.dev",
      },
      "observability": {
        "enabled": true,
      },
    },
  },
}
