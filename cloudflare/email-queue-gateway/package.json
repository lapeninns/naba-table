{
  "name": "@nabatable/email-queue-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local",
    "profile": "mkdir -p ../../.profiles/email-queue-gateway && NODE_OPTIONS='--cpu-prof --cpu-prof-dir=../../.profiles/email-queue-gateway' wrangler dev --local --inspector-port 9232",
    "lint": "eslint --max-warnings=0 src tests vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:ci": "vitest run --coverage --config vitest.config.ts --reporter=default --reporter=junit --outputFile.junit=test-results/vitest/junit.xml --slowTestThreshold=500",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  }
}
