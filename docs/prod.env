# -----------------------------------------------------------------------------
# Nab a Table - Production Environment Variables (Template)
# -----------------------------------------------------------------------------
# This file is a TEMPLATE and must not contain real secrets.
# Store production credentials in your hosting provider's secret manager.

# -----------------------------------------------------------------------------
# App Configuration (production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ROOT_DOMAIN=nabatable.com
ALLOW_MEMORY_RATE_LIMIT_IN_PROD=true
NEXT_PUBLIC_APP_URL=https://nabatable.com
NEXT_PUBLIC_SITE_URL=https://nabatable.com

# -----------------------------------------------------------------------------
# Reserve / Booking API Configuration (PROD)
# -----------------------------------------------------------------------------
RESERVE_API_BASE_URL=https://nabatable.com
NEXT_PUBLIC_RESERVE_API_BASE_URL=https://nabatable.com

# Safety marker: must be a valid URL and match RESERVE_API_BASE_URL in prod
PRODUCTION_BOOKING_API_BASE_URL=https://nabatable.com

# -----------------------------------------------------------------------------
# Database (Supabase)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_prod_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_prod_service_role_key_here

# Environment safety guard values (must match live prod values)
PRODUCTION_SUPABASE_URL=https://your-prod-project.supabase.co
PRODUCTION_SUPABASE_ANON_KEY=your_prod_anon_key_here
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=your_prod_service_role_key_here

# -----------------------------------------------------------------------------
# Emails (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=no-reply@no-reply-notifications.nabatable.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
SUPPORT_FORWARD_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Test email endpoint guardrails (disable in production)
# -----------------------------------------------------------------------------
TEST_EMAIL_ACCESS_TOKEN=your_test_email_token_here
TEST_EMAIL_ALLOWED_ORIGINS=https://nabatable.com
TEST_EMAIL_RATE_LIMIT=10

NEXT_PUBLIC_MAGIC_LINK_BOOKING=on
NEXT_PUBLIC_MAGIC_LINK_ADMIN=on
FEATURE_BOOKING_PAST_TIME_BLOCKING=true

# Draft booking secret (legacy/unused) — leave unset unless feature is revived
BOOKING_DRAFT_SECRET=your_booking_draft_secret_here

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_SELECTOR_SCORING=true
FEATURE_CAPACITY_CONFIG=true
FEATURE_OPS_METRICS=true
FEATURE_ADJACENCY_VALIDATION=true

FEATURE_AUTO_ASSIGN_ON_BOOKING=true
FEATURE_AUTO_ASSIGN_MAX_RETRIES=0
FEATURE_AUTO_ASSIGN_RETRY_DELAYS_MS=0

FEATURE_COMBINATION_PLANNER=true
FEATURE_ALLOCATOR_K_MAX=3
FEATURE_SELECTOR_MAX_COMBINATION_EVALUATIONS=1000

FEATURE_HOLDS_STRICT_CONFLICTS_ENABLED=true
FEATURE_ALLOCATOR_MERGES_ENABLED=true

NEXT_PUBLIC_GUEST_ACCOUNT_REVAMP=true
NEXT_PUBLIC_FEATURE_MANUAL_SESSION_ENABLED=true
FEATURE_MANUAL_ASSIGNMENT_SESSION_ENABLED=true
FEATURE_OPS_BOOKING_LIFECYCLE_V2=true
