      "--pg-ease-out": {
        "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)"
      },
      "--pg-ease-spring": {
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "--pg-ease-snap": {
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "--ease-out": {
        "$value": "var(--pg-ease-spring)"
      },
      "--ease-in-out": {
        "$value": "var(--pg-ease-out)"
      },
      "--pg-transition-hover": {
        "$value": "var(--pg-duration-fast) var(--pg-ease-out)"
      },
      "--pg-transition-panel": {
        "$value": "var(--pg-duration) var(--pg-ease-spring)"
      },
      "--pg-transition-emphasis": {
        "$value": "var(--pg-duration-slow) var(--pg-ease-spring)"
      }
    }
  },
  "theme": {
    "--font-sans": {
      "$value": "var(--font-sajilo)"
    },
    "--font-serif": {
      "$value": "var(--pg-font-display)"
    },
    "--font-mono": {
      "$value": "var(--pg-font-mono)"
    },
    "--tracking-display": {
      "$value": "var(--pg-tracking-display)"
    },
    "--tracking-headline": {
      "$value": "var(--pg-tracking-tight)"
    },
    "--tracking-eyebrow": {
      "$value": "var(--pg-tracking-wide)"
    },
    "--tracking-button": {
      "$value": "var(--pg-tracking-button)"
    },
    "--radius-sm": {
      "$value": "0.375rem"
    },
    "--radius-md": {
      "$value": "0.5rem"
    },
    "--radius-lg": {
      "$value": "0.625rem"
    },
    "--radius-xl": {
      "$value": "0.75rem"
    },
    "--radius-2xl": {
      "$value": "0.875rem"
    },
    "--radius-3xl": {
      "$value": "1rem"
    },
    "--radius-4xl": {
      "$value": "1.25rem"
    }
  }
}
