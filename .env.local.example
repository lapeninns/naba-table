# -----------------------------------------------------------------------------
# Nab a Table - Local Environment Variables (Example)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to version control.
#
# SECURITY NOTE:
# - Do NOT paste production keys here for day-to-day development.
# - Use your hosting provider’s secret manager for production credentials.

# -----------------------------------------------------------------------------
# Mailgun / Email
# -----------------------------------------------------------------------------
EMAIL_SERVER=
# MAILGUN_API_KEY=your_mailgun_api_key_here

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 🌍 Root Domain (CRITICAL for authentication and cookie sharing)
# For production: nabatable.com
# For local development: localhost
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Optional: force single-host routing on custom preview/local hosts
# Comma-separated hostnames (no protocol)
# Example: frontend-2025-dec19.vercel.app,frontend-2025-dec19.local
NEXT_PUBLIC_LOCAL_APP_HOSTS=

# 🏪 Default Restaurant (optional)
# Provide these only if you want a single default restaurant; otherwise select one in ops UI.
BOOKING_DEFAULT_RESTAURANT_ID=
NEXT_PUBLIC_DEFAULT_RESTAURANT_ID=
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=

# Reserve API Configuration
RESERVE_API_BASE_URL=/api
NEXT_PUBLIC_RESERVE_API_BASE_URL=/api
BOOKING_API_BASE_URL=https://api.sajiloreservex.com

# -----------------------------------------------------------------------------
# Database URI (Supabase remote only)
# -----------------------------------------------------------------------------
PROJECT_URL=your_project_id
NEXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@db.your_project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Emails (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=no-reply@no-reply-notifications.nabatable.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
SUPPORT_FORWARD_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Test email endpoint guardrails (never use in production)
# -----------------------------------------------------------------------------
TEST_EMAIL_ACCESS_TOKEN=your_test_email_token_here
TEST_EMAIL_ALLOWED_ORIGINS=http://localhost:3000
TEST_EMAIL_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# Feature Flags / App behavior
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAGIC_LINK_BOOKING=on
NEXT_PUBLIC_MAGIC_LINK_ADMIN=on
FEATURE_BOOKING_PAST_TIME_BLOCKING=true

# Draft booking secret (legacy/unused) — leave unset unless feature is revived
BOOKING_DRAFT_SECRET=your_booking_draft_secret_here

# -----------------------------------------------------------------------------
# 🎯 Feature Flags - Core Features
# -----------------------------------------------------------------------------
FEATURE_SELECTOR_SCORING=true
FEATURE_CAPACITY_CONFIG=true
FEATURE_OPS_METRICS=true
FEATURE_ADJACENCY_VALIDATION=true

# Auto-assign tables for new bookings
FEATURE_AUTO_ASSIGN_ON_BOOKING=true
FEATURE_AUTO_ASSIGN_MAX_RETRIES=0
FEATURE_AUTO_ASSIGN_RETRY_DELAYS_MS=0

# -----------------------------------------------------------------------------
# 🔗 Table Combination Feature
# -----------------------------------------------------------------------------
FEATURE_COMBINATION_PLANNER=true
FEATURE_ALLOCATOR_K_MAX=3
FEATURE_SELECTOR_MAX_COMBINATION_EVALUATIONS=1000

# Enable strict hold conflict enforcement (prevents race conditions)
FEATURE_HOLDS_STRICT_CONFLICTS_ENABLED=true
FEATURE_ALLOCATOR_REQUIRE_ADJACENCY=true
FEATURE_ALLOCATOR_MERGES_ENABLED=true

NEXT_PUBLIC_GUEST_ACCOUNT_REVAMP=true
NEXT_PUBLIC_FEATURE_MANUAL_SESSION_ENABLED=true
FEATURE_MANUAL_ASSIGNMENT_SESSION_ENABLED=true
FEATURE_OPS_BOOKING_LIFECYCLE_V2=true
FEATURE_ASSIGNMENT_PIPELINE_V3_REQUIRE=true
FEATURE_ASSIGNMENT_PIPELINE_V3=true
FEATURE_ASSIGNMENT_PIPELINE_V3_LEGACY_FALLBACK=true
