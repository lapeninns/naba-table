NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Resend (required for app-side transactional/auth email delivery in production)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=no-reply@notifications.nabatable.com
RESEND_USE_MOCK=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAME=www.nabatable.com
AUTH_AUDIT_HASH_SECRET=your_auth_audit_hash_secret

# Adjacency query behavior
# - true: treat adjacency as undirected at query-time (fetch by both table_a + table_b)
# - false: when adjacency edges are stored in both directions (A->B and B->A), we can query by table_a only.
FEATURE_ADJACENCY_QUERY_UNDIRECTED=true

# GBP dual-sync production rollout / rollback flags.
# Default behavior is enabled unless a flag is explicitly set to false/0/no.
GBP_SYNC_ENABLED=true
GBP_IMPORT_ENABLED=true
GBP_EXPORT_ENABLED=true
GBP_AUTO_CANDIDATES_ENABLED=true
GBP_HIGH_RISK_EXPORTS_ENABLED=true
GBP_MENU_SYNC_ENABLED=true
GBP_ATTRIBUTES_SYNC_ENABLED=true
GBP_SCHEDULED_REFRESH_ENABLED=true
