NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# PostHog browser analytics and CLI operations.
# Browser values are public configuration; never put private tokens in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_CLI_API_KEY=your_posthog_personal_api_key
POSTHOG_CLI_PROJECT_ID=your_posthog_project_id
POSTHOG_SOURCEMAP_UPLOAD=false

# Resend (required for app-side transactional/auth email delivery in production)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=no-reply@notifications.nabatable.com
RESEND_USE_MOCK=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAME=www.nabatable.com
AUTH_AUDIT_HASH_SECRET=your_auth_audit_hash_secret

# SMS delivery via Twilio.
# Required for live SMS send/read checks:
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY_SID=your_twilio_api_key_sid
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
# Required for Twilio status callback signatures:
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SHORTEN_URLS=false
# Optional local override for the protected Preview webhook route check.
SMS_DELIVERY_PREVIEW_DEPLOYMENT_URL=https://your-preview-deployment.vercel.app
# Optional local override for readiness callback URL checks.
SMS_DELIVERY_CALLBACK_BASE_URL=https://your-preview-deployment.vercel.app
# Optional local override for Vercel Preview env metadata checks.
SMS_DELIVERY_VERCEL_GIT_BRANCH=your-preview-git-branch
# Required as concrete URLs for Vercel Preview builds and callback URL construction.
NEXT_PUBLIC_APP_URL=https://your-preview-deployment.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-preview-deployment.vercel.app
BASE_URL=https://your-preview-deployment.vercel.app
# Required by SMS readiness migration/index readback; use one of:
SUPABASE_ACCESS_TOKEN=your_supabase_management_access_token
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_password@your_pooler_host:6543/postgres

# Adjacency query behavior
# - true: treat adjacency as undirected at query-time (fetch by both table_a + table_b)
# - false: when adjacency edges are stored in both directions (A->B and B->A), we can query by table_a only.
FEATURE_ADJACENCY_QUERY_UNDIRECTED=true

# GBP dual-sync production rollout / rollback flags.
# Default behavior is enabled unless a flag is explicitly set to false/0/no.
GBP_IMPORT_ENABLED=true
GBP_EXPORT_ENABLED=true
GBP_AUTO_CANDIDATES_ENABLED=true
GBP_HIGH_RISK_EXPORTS_ENABLED=true
GBP_MENU_SYNC_ENABLED=true
GBP_ATTRIBUTES_SYNC_ENABLED=true
GBP_SCHEDULED_REFRESH_ENABLED=true
